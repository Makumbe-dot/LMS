# ---------------------------------------------------------------------------
# Production settings. Copy to backend/.env on the server and fill in.
# Never commit the real file; .gitignore already excludes it.
#
# Generate a secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

APP_NAME=Loan Management System
CURRENCY=USD

# --- the two that matter most ----------------------------------------------
DEBUG=0
SECRET_KEY=PUT-A-64-CHARACTER-RANDOM-STRING-HERE

# Every hostname the app answers on. A request to anything else is refused.
ALLOWED_HOSTS=lms.example.com

TIME_ZONE=Africa/Harare

# --- SQL Server ------------------------------------------------------------
DB_NAME=LMS
DB_HOST=sqlserver.internal
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server

# On a server, prefer a SQL login with least privilege over a trusted
# connection, unless the app runs under a domain service account.
# See sql/02_app_login.sql.
DB_TRUSTED_CONNECTION=0
DB_USER=lms_app
DB_PASSWORD=

# In production the certificate should be a real one, so do not blanket-trust
# the server certificate and do encrypt the connection.
DB_TRUST_SERVER_CERT=0
DB_ENCRYPT=1
DB_CONN_MAX_AGE=120

# --- tokens and sign-in security -------------------------------------------
# --- borrower messages -----------------------------------------------------
# Set these, or the system queues reminders and arrears notices that no borrower
# ever receives. The Messages page says plainly when nothing is being delivered.
MESSAGE_SMS_BACKEND=http
MESSAGE_EMAIL_BACKEND=smtp
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_HTTP_URL=
MESSAGE_HTTP_FORMAT=form
MESSAGE_HTTP_TO_FIELD=to
MESSAGE_HTTP_BODY_FIELD=message
# "key=value" pairs separated by |. Kept out of the URL so a key never reaches a log.
MESSAGE_HTTP_FIELDS=
MESSAGE_HTTP_HEADERS=
MESSAGE_HTTP_ID_PATH=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# A stolen access token is live for this long and cannot be recalled, so keep it
# short. The client renews it silently; nobody is signed out mid-task.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# A teller signs in once a week rather than once a day.
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SIGNING_KEY=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
THROTTLE_LOGIN=10/min

# --- borrower documents ----------------------------------------------------
# Somewhere outside the code directory, backed up with the database.
MEDIA_ROOT=D:\lms-media
MAX_UPLOAD_BYTES=10485760

# --- frontend --------------------------------------------------------------
# Only needed if the SPA is served from a different origin than the API.
# When Django serves frontend/dist there is no cross-origin request at all.
CORS_ALLOWED_ORIGINS=https://lms.example.com

# --- logging ---------------------------------------------------------------
LOG_LEVEL=WARNING
SQL_LOG_LEVEL=WARNING
