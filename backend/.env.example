# ---------------------------------------------------------------------------
# Copy to backend/.env and edit. Never commit the real .env.
# ---------------------------------------------------------------------------

APP_NAME=Loan Management System
CURRENCY=USD
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
TIME_ZONE=UTC

# --- SQL Server ------------------------------------------------------------
# HOST examples:
#   localhost\SQLEXPRESS      named instance (SQL Server Express default)
#   localhost                 default instance
#   10.0.0.5                  remote server, then set DB_PORT=1433
DB_NAME=LMS
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Windows integrated authentication (no username or password needed).
# Set to 0 to use a SQL Server login instead - see sql/02_app_login.sql.
DB_TRUSTED_CONNECTION=1
DB_USER=
DB_PASSWORD=

# ODBC Driver 18 encrypts by default; a local instance normally has a
# self-signed certificate, so the connection has to trust it.
DB_TRUST_SERVER_CERT=1
DB_ENCRYPT=0
DB_CONN_MAX_AGE=60
DB_TEST_NAME=LMS_test

# --- tokens and sign-in security -------------------------------------------
# --- borrower messages -----------------------------------------------------
# "console" logs instead of sending. That is the default ON PURPOSE: a machine
# running against seeded data must not text real-looking phone numbers.
#
# To deliver SMS for real, set MESSAGE_SMS_BACKEND=http and fill in the gateway
# below. Any provider that accepts a form or JSON POST works — Africa's Talking,
# Infobip, Twilio, most aggregators — because which fields carry what is
# configuration, not code.
MESSAGE_SMS_BACKEND=console
MESSAGE_EMAIL_BACKEND=console
# console (log only) | meta | twilio | off (WhatsApp-preferring borrowers get SMS instead)
MESSAGE_WHATSAPP_BACKEND=console
MESSAGE_MAX_ATTEMPTS=3
# Numbers are stored as written (0771 234 567); this country code is added for sending.
MESSAGE_DEFAULT_COUNTRY_CODE=263

# --- WhatsApp through Meta directly (Cloud API) ------------------------------
# MESSAGE_WHATSAPP_BACKEND=meta, then from developers.facebook.com > app > WhatsApp:
# META_WHATSAPP_TOKEN=            a permanent System User token (the API Setup one lasts 24h)
# META_WHATSAPP_PHONE_NUMBER_ID=  the number's id, not the number itself
# META_WHATSAPP_TEMPLATES=reminder=lms_reminder|arrears=lms_arrears|receipt=lms_receipt|promise=lms_promise
# META_WHATSAPP_LANGUAGE=en
# META_GRAPH_VERSION=v23.0
# Delivery reports come to https://<this server>/api/whatsapp/meta/webhook (HTTPS,
# reachable from the internet). In Meta's webhook settings enter that URL and the
# verify token below, and subscribe to "messages".
# META_WHATSAPP_VERIFY_TOKEN=any-string-you-choose
# META_APP_SECRET=the-app-secret     (App settings > Basic)

# --- Twilio: SMS and WhatsApp ------------------------------------------------
# Set MESSAGE_SMS_BACKEND=twilio and/or MESSAGE_WHATSAPP_BACKEND=twilio, then:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
#   (or an API key instead of the auth token:)
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=its-secret
#
# SMS sender: a Twilio number, an approved alphanumeric sender id, or a Messaging
# Service (MG...), which chooses the sender per country.
# TWILIO_SMS_FROM=ZINMAD
# TWILIO_MESSAGING_SERVICE_SID=
#
# WhatsApp: your WhatsApp-enabled number. For Twilio's sandbox, +14155238886
# (each tester first sends the sandbox "join" word to that number).
# TWILIO_WHATSAPP_FROM=+14155238886
#
# Approved WhatsApp templates, one Content SID per message. The wording to submit
# is on the Messages page, under "WhatsApp templates". A message with no template
# goes as plain text, which WhatsApp only delivers within 24 hours of the borrower
# writing to you; otherwise it is resent by SMS automatically.
# TWILIO_WHATSAPP_TEMPLATES=reminder=HX...|arrears=HX...|receipt=HX...|promise=HX...
# MESSAGE_FILE_PATH=logs/messages.log     # only for the "file" backend

# Example, Africa's Talking:
#   MESSAGE_SMS_BACKEND=http
#   MESSAGE_HTTP_URL=https://api.africastalking.com/version1/messaging
#   MESSAGE_HTTP_TO_FIELD=to
#   MESSAGE_HTTP_BODY_FIELD=message
#   MESSAGE_HTTP_FIELDS=username=myshortcode|from=SIMBA
#   MESSAGE_HTTP_HEADERS=apiKey=your-api-key
#   MESSAGE_HTTP_ID_PATH=SMSMessageData.Recipients.0.messageId
#
# Example, Twilio (JSON, basic auth):
#   MESSAGE_SMS_BACKEND=http
#   MESSAGE_HTTP_URL=https://api.twilio.com/2010-04-01/Accounts/ACxxxx/Messages.json
#   MESSAGE_HTTP_TO_FIELD=To
#   MESSAGE_HTTP_BODY_FIELD=Body
#   MESSAGE_HTTP_FIELDS=From=+15551234567
#   MESSAGE_HTTP_HEADERS=Authorization=Basic <base64 of sid:token>
#   MESSAGE_HTTP_ID_PATH=sid
#
# Fixed fields and headers are "key=value" separated by | (not comma: a sender id
# or callback URL routinely contains commas). They travel in the body, not the
# URL, so an API key never lands in an access log.
MESSAGE_HTTP_URL=
MESSAGE_HTTP_FORMAT=form
MESSAGE_HTTP_TO_FIELD=to
MESSAGE_HTTP_BODY_FIELD=message
MESSAGE_HTTP_FIELDS=
MESSAGE_HTTP_HEADERS=
MESSAGE_HTTP_ID_PATH=
MESSAGE_HTTP_TIMEOUT=20

# --- credit bureau ---------------------------------------------------------
# none  = no bureau (the default; the borrower page shows no button)
# demo  = a made-up, repeatable report per national ID, for rehearsals
# http  = a real bureau's JSON API, described by the settings below
BUREAU_BACKEND=none
# A report younger than this many days is read by the scorecard.
BUREAU_VALID_DAYS=90
# BUREAU_HTTP_URL=https://bureau.example.com/api/v1/enquiry
# BUREAU_HTTP_ID_FIELD=national_id
# BUREAU_HTTP_FIELDS=subscriber=SIMBA|product=consumer
# BUREAU_HTTP_HEADERS=Authorization=Bearer your-token
# Dotted paths to the figures in the response (defaults shown):
# BUREAU_HTTP_SCORE_PATH=score
# BUREAU_HTTP_OPEN_ACCOUNTS_PATH=open_accounts
# BUREAU_HTTP_ARREARS_PATH=accounts_in_arrears
# BUREAU_HTTP_DEFAULTS_PATH=defaults
# BUREAU_HTTP_WORST_DAYS_PATH=worst_days_in_arrears
# BUREAU_HTTP_EXPOSURE_PATH=total_exposure
# BUREAU_HTTP_REFERENCE_PATH=reference

# Email, when MESSAGE_EMAIL_BACKEND=smtp.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.com

# The access token cannot be recalled, so this is how long a revoked single device
# keeps working. The client renews silently, so a short lifetime costs requests,
# not sign-ins. Use sign-out-everywhere when 30 minutes is too long to wait.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# How long a session can be renewed before signing in again.
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SIGNING_KEY=
# Lock an account after this many consecutive bad passwords, for this long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Rate limit on the login endpoint.
THROTTLE_LOGIN=20/min

# --- borrower documents ----------------------------------------------------
# Where uploaded KYC paperwork is stored. Put a web server or object store in
# front of this in production.
MEDIA_ROOT=
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/tiff,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --- frontend --------------------------------------------------------------
# Origins allowed to call the API with a bearer token (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Set to DEBUG to print every SQL statement the ORM sends to SQL Server.
SQL_LOG_LEVEL=WARNING

# Incoming payments (core/services/inbound.py). One secret per provider; a provider
# with none is refused. See README "Receiving payments".
# INBOUND_PAYMENT_SECRETS=ecocash=long-random-secret|cbz=another-secret
# INBOUND_PAYMENT_PATHS_ECOCASH=id=transaction.id|amount=transaction.amount

# Reverse proxies in front of the app (IIS, nginx): 1 behind one. The sign-in rate
# limits count per client address read past exactly this many proxies.
# NUM_PROXIES=0
