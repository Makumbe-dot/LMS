# ---------------------------------------------------------------------------
# Copy to backend/.env and edit. Never commit the real .env.
# ---------------------------------------------------------------------------

APP_NAME=Loan Management System
CURRENCY=USD
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
TIME_ZONE=UTC

# --- SQL Server ------------------------------------------------------------
# HOST examples:
#   localhost\SQLEXPRESS      named instance (SQL Server Express default)
#   localhost                 default instance
#   10.0.0.5                  remote server, then set DB_PORT=1433
DB_NAME=LMS
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Windows integrated authentication (no username or password needed).
# Set to 0 to use a SQL Server login instead - see sql/02_app_login.sql.
DB_TRUSTED_CONNECTION=1
DB_USER=
DB_PASSWORD=

# ODBC Driver 18 encrypts by default; a local instance normally has a
# self-signed certificate, so the connection has to trust it.
DB_TRUST_SERVER_CERT=1
DB_ENCRYPT=0
DB_CONN_MAX_AGE=60
DB_TEST_NAME=LMS_test

# --- tokens and sign-in security -------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_SIGNING_KEY=
# Lock an account after this many consecutive bad passwords, for this long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Rate limit on the login endpoint.
THROTTLE_LOGIN=20/min

# --- borrower documents ----------------------------------------------------
# Where uploaded KYC paperwork is stored. Put a web server or object store in
# front of this in production.
MEDIA_ROOT=
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/tiff,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --- frontend --------------------------------------------------------------
# Origins allowed to call the API with a bearer token (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Set to DEBUG to print every SQL statement the ORM sends to SQL Server.
SQL_LOG_LEVEL=WARNING
