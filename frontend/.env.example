# Where the Django API lives during development. The Vite dev server proxies
# /api to this address, so the app itself always uses relative URLs.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Only needed if the built app is served from a different origin than the API.
# Leave blank when Django serves frontend/dist (the normal setup).
VITE_API_BASE=
