# ---------------------------------------------------------------------------
# Settings for the Docker setup (docker-compose.yml). Copy to .env beside it and
# fill in the three secrets. Never commit the real .env; .gitignore excludes it.
#
# This is not backend/.env: that file is for running Django directly on the
# machine, and the containers do not read it.
# ---------------------------------------------------------------------------

# --- the three secrets -------------------------------------------------------
# The SQL Server administrator. SQL Server refuses to start unless it is at least
# eight characters with three of: upper case, lower case, digits, symbols.
MSSQL_SA_PASSWORD=
# The app's own SQL login, created by the db-init service. Same rules.
DB_PASSWORD=
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# --- ports on this machine ---------------------------------------------------
# The app (nginx). Open http://localhost:8080.
HTTP_PORT=8080
# SQL Server, on loopback only, for SSMS. Change it if a local instance already
# has 1433.
SQLSERVER_PORT=1433

# --- SQL Server ----------------------------------------------------------------
# Developer (free, not for production), Express (free, 10 GB per database), or a
# product key.
MSSQL_PID=Developer
DB_NAME=LMS
DB_USER=lms_app

# --- Django ------------------------------------------------------------------
# DEBUG stays 0 in containers: gunicorn serves the app as it would in production.
DEBUG=0
# Every hostname the app is reached by. Add the server's name when it is not
# only used from this machine.
ALLOWED_HOSTS=localhost,127.0.0.1
# The address people type into the browser, so Django admin's CSRF check passes.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# 1 once a TLS-terminating proxy sits in front and sets X-Forwarded-Proto.
SECURE_SSL_REDIRECT=0

APP_NAME=Loan Management System
CURRENCY=USD
TIME_ZONE=UTC

# --- nightly batch -----------------------------------------------------------
# Backups older than this many days are deleted from the backups volume.
BACKUP_RETENTION_DAYS=14

# Any other setting in backend/.env.example (MESSAGE_*, BUREAU_*, EMAIL_*,
# ACCESS_TOKEN_EXPIRE_MINUTES, LOGIN_MAX_ATTEMPTS, ...) can be added here too and
# reaches the backend unchanged. The DB_HOST, DB_DRIVER and MEDIA_ROOT settings
# are fixed by docker-compose.yml and cannot be overridden from here.
